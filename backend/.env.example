APP_NAME=Sopi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sopi
DB_USERNAME=sopi
DB_PASSWORD=change-me

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database

# Paiement : fake (développement/tests) ou dexpay
PAYMENT_DRIVER=fake
DEXPAY_BASE_URL=https://api.dexpay.example
DEXPAY_API_KEY=cle-factice
DEXPAY_WEBHOOK_SECRET=secret-factice

# E-mail (SMTP)
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=utilisateur-factice
MAIL_PASSWORD=mot-de-passe-factice
MAIL_FROM_ADDRESS=no-reply@sopi.example

# Notifications push (FCM) : JSON ou chemin vers le fichier (ne jamais committer)
FCM_CREDENTIALS=

# Premier administrateur (créé par le seeder)
ADMIN_EMAIL=admin@sopi.example
ADMIN_PASSWORD=change-me-admin

# Règles métier (valeurs initiales)
ACOMPTE_RATE=0.30
COMMISSION_RATE=0.10
SLOT_LOCK_MINUTES=5

# Origines autorisées à appeler l'API depuis un navigateur (liste séparée par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173
