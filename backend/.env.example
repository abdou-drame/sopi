APP_NAME=Sopi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.0.0-dev
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sopi
DB_USERNAME=sopi
DB_PASSWORD=change-me

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database

# Paiement : fake (développement/tests) ou dexpay
PAYMENT_DRIVER=fake
# Facultative : vide = https://api.dexpay.africa/api/v1. Si fournie : https://, sans « / » final (bac à sable : https://api-sandbox.dexpay.africa/api/v1)
DEXPAY_BASE_URL=
DEXPAY_PUBLIC_KEY=
DEXPAY_SECRET_KEY=
DEXPAY_COUNTRY=SN
DEXPAY_SUCCESS_URL=
DEXPAY_FAILURE_URL=
DEXPAY_TIMEOUT_SECONDS=15
# Temporaire, à désactiver après les essais : true ajoute un champ « diagnostic » (sans secret) aux réponses 503 liées à DexPay.
DEXPAY_DIAGNOSTIC_REPONSE=false
DEXPAY_AMOUNT_FACTOR=1
DEXPAY_PAYOUT_OPERATOR_FIELDS=operator
DEXPAY_OPERATEUR_WAVE=wave_sn_payout
DEXPAY_OPERATEUR_ORANGE_MONEY=orange_money_sn_payout
PAYMENT_SIGNATURE_HEADER=X-Webhook-Signature
PAIEMENT_REMBOURSEMENT_MAX_TENTATIVES=10
PAIEMENT_REMBOURSEMENT_DELAI_MINUTES=5
RETRAIT_MONTANT_MINIMUM=1000
RETRAIT_MONTANT_MAXIMUM=500000
RETRAIT_DELAI_BLOCAGE_MINUTES=15

# E-mail (SMTP)
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=utilisateur-factice
MAIL_PASSWORD=mot-de-passe-factice
MAIL_FROM_ADDRESS=no-reply@sopi.example
MAIL_FROM_NAME=Sopi

# Notifications push (FCM) : contenu JSON du compte de service, ou ce JSON encodé en base64 (ne jamais committer)
FCM_CREDENTIALS=
# Facultatif : déduit du JSON ci-dessus si absent
FCM_PROJECT_ID=

# Premier administrateur : lu uniquement par la commande `php artisan sopi:creer-admin` (lancée à la main).
# Valeurs à définir sur le serveur (Dokploy), jamais dans le dépôt. ADMIN_EMAIL est optionnel.
ADMIN_NOM=
ADMIN_PRENOM=
ADMIN_TELEPHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Alertes du tableau de bord administrateur (seuils de gravité, valeurs par défaut)
ADMIN_ALERTE_AGE_ATTENTION_HEURES=24
ADMIN_ALERTE_AGE_CRITIQUE_HEURES=72
ADMIN_ALERTE_RETRAITS_CRITIQUE_MINUTES=60
ADMIN_ALERTE_REMBOURSEMENTS_RETARD_MINUTES=30
ADMIN_ALERTE_NOTIFICATIONS_CRITIQUE_SEUIL=20
ADMIN_ALERTE_SUSPENSION_EXPIRATION_HEURES=24
ADMIN_ALERTE_IDS_MAX=20

# Règles métier (valeurs initiales)
ACOMPTE_RATE=0.30
COMMISSION_RATE=0.10
SLOT_LOCK_MINUTES=5
RESERVATION_DELAI_REPONSE_HEURES=12
RESERVATION_DELAI_PAIEMENT_HEURES=2
RESERVATION_ANNULATION_CLIENT_HEURES=2

# Origines autorisées à appeler l'API depuis un navigateur (liste séparée par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Notifications : pilotes log (rien n'est envoyé), smtp (e-mail, utilise MAIL_*) ou fcm (push, utilise FCM_CREDENTIALS)
NOTIFICATION_EMAIL_DRIVER=log
NOTIFICATION_PUSH_DRIVER=log
NOTIFICATION_MAX_TENTATIVES=5
NOTIFICATION_DELAI_ESSAI_MINUTES=5
