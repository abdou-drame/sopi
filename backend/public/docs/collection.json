                            "body": "{\"nomEntreprise\":\"Garage Moussa\",\"metier\":\"mecanique\",\"statutCompte\":\"en_attente\",\"motifRefus\":null,\"dateSoumission\":\"2026-10-12T09:30:00+00:00\",\"justificatifs\":[{\"typeDocument\":\"cni\",\"statut\":\"en_attente\"},{\"typeDocument\":\"diplome\",\"statut\":\"en_attente\"}]}",
